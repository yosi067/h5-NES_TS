    {"id":"opening-cutscenes.11.text.00fc","source":"・・・","translation":"……"},
    {"id":"opening-cutscenes.12.text.0015","source":"だとう なんかつは","translation":"擊敗南葛之願"},
    {"id":"opening-cutscenes.12.text.003e","source":"おれは まけない!","translation":"我不會輸的！"},
    {"id":"opening-cutscenes.12.text.005f","source":"がんばって・・・","translation":"加油……"},
    {"id":"opening-cutscenes.12.text.007a","source":"みていてくれ・・・","translation":"看著我吧……"},
    {"id":"opening-cutscenes.13.text.0047","source":"・・・","translation":"……"},
    {"id":"opening-cutscenes.13.text.009e","source":"これで けっしょうせんは","translation":"決賽將由"},
    {"id":"opening-cutscenes.13.text.00b1","source":"とうほうの","translation":"與東邦"},
