    {"id":"opening-cutscenes.04.text.027d","source":" きかない・・・","translation":"竟然不管用……"},
    {"id":"opening-cutscenes.05.text.0018","source":"おまえとは","translation":"盼與你"},
    {"id":"opening-cutscenes.05.text.00a8","source":"このリオカップ","translation":"里約盃"},
