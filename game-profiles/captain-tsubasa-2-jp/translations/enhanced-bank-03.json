    {"id":"opening-cutscenes.01.text.0302","source":"にほんサッカー","translation":"日本足球"},
    {"id":"opening-cutscenes.01.text.030a","source":"きょうかいの かたぎり むねまさな","translation":"協會的片桐宗政"},
    {"id":"opening-cutscenes.01.text.0324","source":"よろしく","translation":"請"},
