{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h5-nes.local/schema/game-presentation.schema.json",
  "title": "Game Translation Presentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "inputArmFrame", "cues"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "inputArmFrame": { "type": "integer", "minimum": 0 },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "masks", "labels"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "from"],
            "properties": {
              "type": { "enum": ["frame", "afterInput"] },
              "from": { "type": "integer", "minimum": 0 },
              "to": { "type": "integer", "minimum": 0 }
            }
          },
          "regionGuard": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height", "hash"],
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "hash": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
              "sampleStep": { "type": "integer", "minimum": 1 }
            }
          },
          "masks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "color": { "type": "string" }
              }
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "x", "y", "size"],
              "properties": {
                "text": { "type": "string" },
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "size": { "type": "integer", "minimum": 1 },
                "align": { "enum": ["left", "center", "right"] },
                "color": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
