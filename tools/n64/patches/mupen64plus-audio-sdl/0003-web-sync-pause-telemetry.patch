diff --git a/src/sdl_backend.c b/src/sdl_backend.c
index c6060fa..8b50200 100644
--- a/src/sdl_backend.c
+++ b/src/sdl_backend.c
@@ -530,6 +530,31 @@ static size_t estimate_level_at_next_audio_cb(struct sdl_backend* sdl_backend)
     return expected_level;
 }
 
+#if EMSCRIPTEN
+/* SDL pauses output while the core is behind. Paused callbacks never reach
+ * my_audio_callback, so they are invisible to the underrun counters. */
+EM_JS(void, audio_web_sync_pause_changed, (int paused), {
+    var counters = globalThis.__n64WebCounters;
+    if (!counters) {
+        counters = globalThis.__n64WebCounters = {
+            version: 1, viInterrupts: 0, viRefreshRate: 0,
+            audioSyncPauses: 0, audioSyncPausedMs: 0, audioSyncPausedSince: null
+        };
+    }
+    var now = performance.now();
+    if (paused) {
+        counters.audioSyncPauses++;
+        counters.audioSyncPausedSince = now;
+    } else if (counters.audioSyncPausedSince !== null) {
+        counters.audioSyncPausedMs += now - counters.audioSyncPausedSince;
+        counters.audioSyncPausedSince = null;
+    }
+});
+#define AUDIO_WEB_SYNC_PAUSE_CHANGED(paused) audio_web_sync_pause_changed(paused)
+#else
+#define AUDIO_WEB_SYNC_PAUSE_CHANGED(paused)
+#endif
+
 void sdl_synchronize_audio(struct sdl_backend* sdl_backend)
 {
     enum { TOLERANCE_MS = 10 };
@@ -544,7 +569,7 @@ void sdl_synchronize_audio(struct sdl_backend* sdl_backend)
          * delay emulation to allow the SDL audio thread to catch up */
         unsigned int wait_time = (expected_level - sdl_backend->target) * 1000 / sdl_backend->output_frequency;
 
-        if (sdl_backend->paused_for_sync) { SDL_PauseAudio(0); }
+        if (sdl_backend->paused_for_sync) { SDL_PauseAudio(0); AUDIO_WEB_SYNC_PAUSE_CHANGED(0); }
         sdl_backend->paused_for_sync = 0;
 
         SDL_Delay(wait_time);
@@ -553,14 +578,14 @@ void sdl_synchronize_audio(struct sdl_backend* sdl_backend)
     {
         /* Core is behind SDL audio thread (predicting an underflow),
          * pause the audio to let the Core catch up */
-        if (!sdl_backend->paused_for_sync) { SDL_PauseAudio(1); }
+        if (!sdl_backend->paused_for_sync) { SDL_PauseAudio(1); AUDIO_WEB_SYNC_PAUSE_CHANGED(1); }
         sdl_backend->paused_for_sync = 1;
     }
     else
     {
         /* Expected fullness is within tolerance,
          * audio thread is running */
-        if (sdl_backend->paused_for_sync) { SDL_PauseAudio(0); }
+        if (sdl_backend->paused_for_sync) { SDL_PauseAudio(0); AUDIO_WEB_SYNC_PAUSE_CHANGED(0); }
         sdl_backend->paused_for_sync = 0;
     }
 }
