diff --git a/src/sdl_backend.c b/src/sdl_backend.c
index 8771917..1318da8 100644
--- a/src/sdl_backend.c
+++ b/src/sdl_backend.c
@@ -103,0 +104,5 @@ struct sdl_backend
+    unsigned int callback_count;
+    unsigned int partial_underrun_count;
+    unsigned int empty_underrun_count;
+    unsigned int last_audio_cb_time;
+    unsigned int max_callback_gap_ms;
@@ -111,0 +117,13 @@ struct sdl_backend
+#if EMSCRIPTEN
+EM_JS(void, audio_web_push_samples, (const void* stream, int len), {
+    if (!Module.n64AudioWorkletPort || len <= 0)
+        return;
+    const sampleCount = len >> 1;
+    const samples = new Float32Array(sampleCount);
+    const source = stream >> 1;
+    for (let index = 0; index < sampleCount; ++index)
+        samples[index] = HEAP16[source + index] / 32768;
+    Module.n64AudioWorkletPort.postMessage({ type: 'samples', samples }, [samples.buffer]);
+});
+#endif
+
@@ -123,0 +142,10 @@ static void my_audio_callback(void* userdata, unsigned char* stream, int len)
+    unsigned int now = SDL_GetTicks();
+    if (sdl_backend->last_audio_cb_time != 0)
+    {
+        unsigned int callback_gap = now - sdl_backend->last_audio_cb_time;
+        if (callback_gap > sdl_backend->max_callback_gap_ms)
+            sdl_backend->max_callback_gap_ms = callback_gap;
+    }
+    sdl_backend->last_audio_cb_time = now;
+    ++sdl_backend->callback_count;
+
@@ -125 +153 @@ static void my_audio_callback(void* userdata, unsigned char* stream, int len)
-    sdl_backend->last_cb_time = SDL_GetTicks();
+    sdl_backend->last_cb_time = now;
@@ -132,0 +161,1 @@ static void my_audio_callback(void* userdata, unsigned char* stream, int len)
+    size_t web_audio_len = len;
@@ -144,0 +173,5 @@ static void my_audio_callback(void* userdata, unsigned char* stream, int len)
+        size_t partial_len = (available * newsamplerate) / oldsamplerate;
+        partial_len = (partial_len / SDL_SAMPLE_BYTES) * SDL_SAMPLE_BYTES;
+        if (partial_len > (size_t)len)
+            partial_len = len;
+        web_audio_len = partial_len;
+
@@ -146 +179,13 @@ static void my_audio_callback(void* userdata, unsigned char* stream, int len)
-        memset(stream, 0, len);
+        if (available == 0)
+            ++sdl_backend->empty_underrun_count;
+        else
+            ++sdl_backend->partial_underrun_count;
+        if (partial_len > 0)
+        {
+            consumed = ResampleAndMix(sdl_backend->resampler, sdl_backend->iresampler,
+                    sdl_backend->mix_buffer,
+                    src, available, oldsamplerate,
+                    stream, partial_len, newsamplerate);
+            consume_cbuff_data(&sdl_backend->primary_buffer, consumed);
+        }
+        memset(stream + partial_len, 0, len - partial_len);
@@ -147,0 +193,29 @@ static void my_audio_callback(void* userdata, unsigned char* stream, int len)
+
+#if EMSCRIPTEN
+    audio_web_push_samples(stream, web_audio_len);
+#endif
+}
+
