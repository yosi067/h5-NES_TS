+}
+
+unsigned int sdl_get_empty_underrun_count(const struct sdl_backend* sdl_backend)
+{
+    return sdl_backend->empty_underrun_count;
+}
+
+unsigned int sdl_get_max_callback_gap_ms(const struct sdl_backend* sdl_backend)
+{
+    return sdl_backend->max_callback_gap_ms;
