diff --git a/src/RiceCullCache.h b/src/RiceCullCache.h
new file mode 100644
--- /dev/null
+++ b/src/RiceCullCache.h
@@ -0,0 +1,58 @@
+// Shared by all Rice translation units that write GL_CULL_FACE.
+// Single active Rice context; initialization's glDisable seeds every new context.
+#pragma once
+#if EMSCRIPTEN
+#include <emscripten.h>
+inline bool RiceCullCacheEnabled()
+{
+    static const bool enabled = EM_ASM_INT({
+        const enabled = new URLSearchParams(globalThis.location.search).get('n64CullStateCache') === '1';
+        globalThis.__n64CullStateCacheEnabled = enabled;
+        return enabled;
+    });
+    return enabled;
+}
+struct RiceCullState
+{
+    bool known;
+    GLboolean enabled;
+    RiceCullState() : known(false), enabled(GL_FALSE) {}
+};
+inline RiceCullState &RiceSharedCullState()
+{
+    // External-linkage inline function: one local static across translation units.
+    static RiceCullState state;
+    return state;
+}
+inline void RiceTrackedEnable(GLenum cap)
+{
+    glEnable(cap);
+    if (cap == GL_CULL_FACE) {
+        RiceSharedCullState().known = true;
+        RiceSharedCullState().enabled = GL_TRUE;
+    }
+}
+inline void RiceTrackedDisable(GLenum cap)
+{
+    glDisable(cap);
+    if (cap == GL_CULL_FACE) {
+        RiceSharedCullState().known = true;
+        RiceSharedCullState().enabled = GL_FALSE;
+    }
+}
+inline GLboolean RiceCachedIsEnabled(GLenum cap)
+{
+    if (!RiceCullCacheEnabled() || cap != GL_CULL_FACE) return glIsEnabled(cap);
+    RiceCullState &state = RiceSharedCullState();
+    if (!state.known) {
+        state.enabled = glIsEnabled(cap);
+        state.known = true;
+    }
+    return state.enabled;
+}
+#endif
