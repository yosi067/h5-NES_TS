@@ -687,0 +688,12 @@
+// Keep phase timing around the selected query implementation and real writes.
+// Defined after diagnostics wrappers; helpers above were compiled against raw GL.
+#if EMSCRIPTEN
+#undef glIsEnabled
+#undef glEnable
+#undef glDisable
+#define glIsEnabled(...) RICE_RECT_CALL(1, RiceCachedIsEnabled(__VA_ARGS__))
+#define glEnable(...) RICE_RECT_CALL(2, RiceTrackedEnable(__VA_ARGS__))
+#define glDisable(...) RICE_RECT_CALL(2, RiceTrackedDisable(__VA_ARGS__))
+#endif
