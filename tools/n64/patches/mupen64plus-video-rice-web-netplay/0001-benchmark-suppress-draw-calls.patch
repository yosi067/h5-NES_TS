+static const size_t RICE_STREAM_BATCH_VERTICES = 1000;
+static const size_t RICE_STREAM_BUFFER_BATCHES = 64;
+static RiceStreamVertex g_streamVertices[RICE_STREAM_BATCH_VERTICES];
+static GLuint g_streamBuffer;
+static size_t g_streamWriteOffset;
+static bool g_streamNeedsOrphan = true;
