+static GLuint g_rectStreamBuffer;
+static size_t g_rectStreamWriteOffset;
+static bool g_rectStreamNeedsOrphan = true;
+
+static void RiceEnsurePersistentBuffers()
+{
+    if (g_streamBuffer != 0) return;
+
+    glGenBuffers(1, &g_streamBuffer);
+    glBindBuffer(GL_ARRAY_BUFFER, g_streamBuffer);
+    glBufferData(GL_ARRAY_BUFFER,
+        sizeof(g_streamVertices) * RICE_STREAM_BUFFER_BATCHES, NULL, GL_STREAM_DRAW);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+}
+
+static bool RiceDrawTrianglesWithPersistentBuffers()
+{
+    const size_t vertexCount = gRSP.numVertices;
+    if (vertexCount > RICE_STREAM_BATCH_VERTICES) return false;
+
+    RiceEnsurePersistentBuffers();
+
+    double phaseStartedAt = emscripten_get_now();
+    for (size_t i = 0; i < vertexCount; ++i)
+    {
+        RiceStreamVertex &target = g_streamVertices[i];
+        target.position[0] = g_vtxProjected5[i][0];
+        target.position[1] = g_vtxProjected5[i][1];
+        target.position[2] = g_vtxProjected5[i][2];
+        target.position[3] = g_vtxProjected5[i][3];
+        target.fog = g_vtxProjected5[i][4];
+        target.texCoord0[0] = g_vtxBuffer[i].tcord[0].u;
+        target.texCoord0[1] = g_vtxBuffer[i].tcord[0].v;
+        target.texCoord1[0] = g_vtxBuffer[i].tcord[1].u;
+        target.texCoord1[1] = g_vtxBuffer[i].tcord[1].v;
+        target.color[0] = g_oglVtxColors[i][0];
+        target.color[1] = g_oglVtxColors[i][1];
+        target.color[2] = g_oglVtxColors[i][2];
+        target.color[3] = g_oglVtxColors[i][3];
+    }
+    g_trianglePrepareMs += emscripten_get_now() - phaseStartedAt;
+
+    const size_t uploadSize = vertexCount * sizeof(RiceStreamVertex);
+    const size_t bufferSize = sizeof(g_streamVertices) * RICE_STREAM_BUFFER_BATCHES;
+    phaseStartedAt = emscripten_get_now();
+    glBindBuffer(GL_ARRAY_BUFFER, g_streamBuffer);
+    if (g_streamNeedsOrphan || g_streamWriteOffset + uploadSize > bufferSize)
+    {
+        glBufferData(GL_ARRAY_BUFFER, bufferSize, NULL, GL_STREAM_DRAW);
+        g_streamWriteOffset = 0;
+        g_streamNeedsOrphan = false;
+    }
+    glBufferSubData(GL_ARRAY_BUFFER, g_streamWriteOffset, uploadSize, g_streamVertices);
+    g_triangleUploadMs += emscripten_get_now() - phaseStartedAt;
+
+    const size_t baseOffset = g_streamWriteOffset;
+    phaseStartedAt = emscripten_get_now();
+    glVertexAttribPointer(VS_POSITION, 4, GL_FLOAT, GL_FALSE,
+        sizeof(RiceStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceStreamVertex, position)));
+    glVertexAttribPointer(VS_FOG, 1, GL_FLOAT, GL_FALSE,
+        sizeof(RiceStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceStreamVertex, fog)));
+    glVertexAttribPointer(VS_TEXCOORD0, 2, GL_FLOAT, GL_FALSE,
+        sizeof(RiceStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceStreamVertex, texCoord0)));
+    glVertexAttribPointer(VS_TEXCOORD1, 2, GL_FLOAT, GL_FALSE,
+        sizeof(RiceStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceStreamVertex, texCoord1)));
+    glVertexAttribPointer(VS_COLOR, 4, GL_UNSIGNED_BYTE, GL_TRUE,
+        sizeof(RiceStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceStreamVertex, color)));
+
+    glDrawArrays(GL_TRIANGLES, 0, vertexCount);
+    g_triangleSubmitMs += emscripten_get_now() - phaseStartedAt;
+    g_streamWriteOffset += uploadSize;
+    phaseStartedAt = emscripten_get_now();
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glVertexAttribPointer(VS_POSITION, 4, GL_FLOAT, GL_FALSE,
+        sizeof(float) * 5, &(g_vtxProjected5[0][0]));
+    glVertexAttribPointer(VS_FOG, 1, GL_FLOAT, GL_FALSE,
+        sizeof(float) * 5, &(g_vtxProjected5[0][4]));
+    glVertexAttribPointer(VS_TEXCOORD0, 2, GL_FLOAT, GL_FALSE,
+        sizeof(TLITVERTEX), &(g_vtxBuffer[0].tcord[0].u));
+    glVertexAttribPointer(VS_TEXCOORD1, 2, GL_FLOAT, GL_FALSE,
+        sizeof(TLITVERTEX), &(g_vtxBuffer[0].tcord[1].u));
+    glVertexAttribPointer(VS_COLOR, 4, GL_UNSIGNED_BYTE, GL_TRUE,
+        sizeof(uint8) * 4, &(g_oglVtxColors[0][0]));
+    g_triangleRestoreMs += emscripten_get_now() - phaseStartedAt;
+    return true;
+}
+
+static bool RiceDrawRectWithPersistentBuffer(GLenum mode, size_t vertexCount,
+    const GLfloat *positions, const GLfloat *texCoord0, const GLfloat *texCoord1,
+    const GLubyte *colors, GLboolean normalizeColors)
+{
+    if (vertexCount > 6) return false;
+
+    if (g_rectStreamBuffer == 0)
+    {
+        glGenBuffers(1, &g_rectStreamBuffer);
+        glBindBuffer(GL_ARRAY_BUFFER, g_rectStreamBuffer);
+        glBufferData(GL_ARRAY_BUFFER,
+            RICE_RECT_STREAM_VERTICES * sizeof(RiceRectStreamVertex), NULL, GL_STREAM_DRAW);
+        glBindBuffer(GL_ARRAY_BUFFER, 0);
+    }
+
+    for (size_t i = 0; i < vertexCount; ++i)
+    {
+        RiceRectStreamVertex &target = g_rectStreamVertices[i];
+        memcpy(target.position, positions + i * 4, sizeof(target.position));
+        if (texCoord0 != NULL)
+        {
+            memcpy(target.texCoord0, texCoord0 + i * 2, sizeof(target.texCoord0));
+            memcpy(target.texCoord1, texCoord1 + i * 2, sizeof(target.texCoord1));
+        }
+        memcpy(target.color, colors + i * 4, sizeof(target.color));
+    }
+
+    const size_t uploadSize = vertexCount * sizeof(RiceRectStreamVertex);
+    const size_t bufferSize = RICE_RECT_STREAM_VERTICES * sizeof(RiceRectStreamVertex);
+    glBindBuffer(GL_ARRAY_BUFFER, g_rectStreamBuffer);
+    if (g_rectStreamNeedsOrphan || g_rectStreamWriteOffset + uploadSize > bufferSize)
+    {
+        glBufferData(GL_ARRAY_BUFFER, bufferSize, NULL, GL_STREAM_DRAW);
+        g_rectStreamWriteOffset = 0;
+        g_rectStreamNeedsOrphan = false;
+    }
+    glBufferSubData(GL_ARRAY_BUFFER, g_rectStreamWriteOffset, uploadSize, g_rectStreamVertices);
+
+    const size_t baseOffset = g_rectStreamWriteOffset;
+    glVertexAttribPointer(VS_POSITION, 4, GL_FLOAT, GL_FALSE,
+        sizeof(RiceRectStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceRectStreamVertex, position)));
+    if (texCoord0 != NULL)
+    {
+        glVertexAttribPointer(VS_TEXCOORD0, 2, GL_FLOAT, GL_FALSE,
+            sizeof(RiceRectStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceRectStreamVertex, texCoord0)));
+        glVertexAttribPointer(VS_TEXCOORD1, 2, GL_FLOAT, GL_FALSE,
+            sizeof(RiceRectStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceRectStreamVertex, texCoord1)));
+    }
+    glVertexAttribPointer(VS_COLOR, 4, GL_UNSIGNED_BYTE, normalizeColors,
+        sizeof(RiceRectStreamVertex), (const GLvoid *)(baseOffset + offsetof(RiceRectStreamVertex, color)));
+    glDrawArrays(mode, 0, vertexCount);
+    g_rectStreamWriteOffset += uploadSize;
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    return true;
+}
+
+class RiceDrawTimer
+{
+public:
+    RiceDrawTimer(double *totalMs, uint32 *calls)
+        : m_totalMs(totalMs), m_startedAt(emscripten_get_now())
+    {
+        (*calls)++;
+    }
+
+    ~RiceDrawTimer()
+    {
+        *m_totalMs += emscripten_get_now() - m_startedAt;
+    }
+
+private:
+    double *m_totalMs;
+    double m_startedAt;
+};
+
+#define RICE_DRAW_TIMER(total, calls) RiceDrawTimer drawTimer(&(total), &(calls))
+
+extern "C" void rice_web_draw_timing_reset(void)
+{
+    g_triangleDrawMs = 0.0;
+    g_rectDrawMs = 0.0;
+    g_trianglePrepareMs = 0.0;
+    g_triangleUploadMs = 0.0;
+    g_triangleSubmitMs = 0.0;
+    g_triangleRestoreMs = 0.0;
+    g_triangleDrawCalls = 0;
+    g_rectDrawCalls = 0;
+    g_streamNeedsOrphan = true;
+    g_rectStreamNeedsOrphan = true;
+}
+
