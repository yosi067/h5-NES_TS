+extern "C" double rice_web_triangle_prepare_ms(void) { return g_trianglePrepareMs; }
+extern "C" double rice_web_triangle_upload_ms(void) { return g_triangleUploadMs; }
+extern "C" double rice_web_triangle_submit_ms(void) { return g_triangleSubmitMs; }
+extern "C" double rice_web_triangle_restore_ms(void) { return g_triangleRestoreMs; }
+extern "C" uint32 rice_web_triangle_draw_calls(void) { return g_triangleDrawCalls; }
+extern "C" uint32 rice_web_rect_draw_calls(void) { return g_rectDrawCalls; }
+#else
+#define RICE_DRAW_TIMER(total, calls)
+#endif
