+#if EMSCRIPTEN
+/* The web main loop yields per video swap, not per VI. Publish the real
+ * VI interrupt count so the frontend can measure emulation speed. */
+EM_JS(void, web_count_vi, (unsigned int refresh_rate), {
+    var counters = globalThis.__n64WebCounters;
+    if (!counters) {
+        counters = globalThis.__n64WebCounters = {
+            version: 1, viInterrupts: 0, viRefreshRate: 0,
+            audioSyncPauses: 0, audioSyncPausedMs: 0, audioSyncPausedSince: null
+        };
+    }
+    counters.viInterrupts++;
+    counters.viRefreshRate = refresh_rate;
+});
+#endif
