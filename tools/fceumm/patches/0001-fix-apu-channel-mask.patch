From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: H5-EMU maintainers <>
Date: Sat, 1 Jun 2024 00:00:00 +0000
Subject: [PATCH] Fix APU channel option bit masks

The libretro channel selector uses one bit per NES audio source. The old
assignments swapped the pulse channels and reused low bits for the remaining
channels, so selectors could not independently enable all five sources.

This patch applies to libretro-fceumm revision
e1630de02074801eb96f3bc4ff33f69df9554c69.

---
 src/drivers/libretro/libretro.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/drivers/libretro/libretro.c b/src/drivers/libretro/libretro.c
--- a/src/drivers/libretro/libretro.c
+++ b/src/drivers/libretro/libretro.c
@@ -1902,7 +1902,7 @@ static void set_apu_channels(int chan)
 {
-   FSettings.SquareVolume[1] = (chan & 1) ? 256 : 0;
-   FSettings.SquareVolume[0] = (chan & 2) ? 256 : 0;
-   FSettings.TriangleVolume  = (chan & 3) ? 256 : 0;
-   FSettings.NoiseVolume     = (chan & 4) ? 256 : 0;
-   FSettings.PCMVolume       = (chan & 5) ? 256 : 0;
+   FSettings.SquareVolume[0] = (chan & 0x01) ? 256 : 0;
+   FSettings.SquareVolume[1] = (chan & 0x02) ? 256 : 0;
+   FSettings.TriangleVolume  = (chan & 0x04) ? 256 : 0;
+   FSettings.NoiseVolume     = (chan & 0x08) ? 256 : 0;
+   FSettings.PCMVolume       = (chan & 0x10) ? 256 : 0;
 }
