{
  "name": "h5-nes",
  "version": "0.1.0",
  "description": "NES 模擬器 - HTML5/TypeScript 實作",
  "type": "module",
  "scripts": {
    "wasm:build": "cd nes-wasm && wasm-pack build --target web --out-dir ../src/wasm",
    "n64:source": "powershell -ExecutionPolicy Bypass -File tools/n64/bootstrap-mupen.ps1",
    "n64:build": "powershell -ExecutionPolicy Bypass -File tools/n64/build-mupen.ps1",
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0",
    "build": "npm run wasm:build && tsc --noEmit && node -e \"require('fs').rm('dist',{recursive:true,force:true},e=>{if(e)throw e})\" && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:cpu": "vitest run --testPathPattern=cpu",
    "test:ppu": "vitest run --testPathPattern=ppu",
    "test:apu": "vitest run --testPathPattern=apu",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "nes",
    "emulator",
    "6502",
    "typescript",
    "html5"
  ],
  "dependencies": {
    "@mantou/fbneo": "^0.0.4",
    "jszip": "^3.10.1",
    "mupen64plus-web": "^1.5.7"
  }
}
