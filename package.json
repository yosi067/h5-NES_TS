{
  "name": "h5-nes",
  "version": "0.1.0",
  "description": "NES 模擬器 - HTML5/TypeScript 實作",
  "type": "module",
  "scripts": {
    "wasm:build": "cd nes-wasm && wasm-pack build --target web --out-dir ../src/wasm",
    "n64:source": "powershell -ExecutionPolicy Bypass -File tools/n64/bootstrap-mupen.ps1",
    "n64:build": "powershell -ExecutionPolicy Bypass -File tools/n64/build-mupen.ps1",
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0",
    "build": "npm run wasm:build && tsc --noEmit && node -e \"require('fs').rm('dist',{recursive:true,force:true},e=>{if(e)throw e})\" && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:cpu": "vitest run --testPathPattern=cpu",
    "test:ppu": "vitest run --testPathPattern=ppu",
    "test:apu": "vitest run --testPathPattern=apu",
    "test:ui": "vitest --ui",
    "test:profiles": "node --test tools/game-profile.test.mjs tools/captain-tsubasa-2-adapter.test.mjs tools/compile-captain-tsubasa-2-opening.test.mjs",
    "profile": "node tools/game-profile.mjs",
    "localization:build": "node tools/build-ct2-localization.mjs",
    "ct2:stats:research": "node tools/ct2-stats-research.mjs",
    "test:ct2:stats": "node --test tools/ct2-stats-research.test.mjs tools/ct2-runtime-tuning.test.mjs && vitest run tests/ct2-stats-preview.test.ts tests/ct2-runtime-tuning.test.ts",
    "test:ct2:stats:rom": "cargo test --manifest-path nes-wasm/Cargo.toml --release ct2_original_stats_diagnostic -- --ignored --nocapture && cargo test --manifest-path nes-wasm/Cargo.toml --release ct2_runtime_tuning_original_rom -- --ignored --nocapture",
    "test:localization": "vitest run tests/localization.test.ts tests/battle-localization.test.ts tests/text-overlay.test.ts tests/menu-localization.test.ts tests/translation-editor.test.ts tests/ct2-overlay-runtime.test.ts",
    "test:localization:battle:rom": "node --test tools/ct2-battle-runtime.test.mjs",
    "test:localization:special-shot:rom": "node tools/ct2-match-probe.mjs --verify",
    "test:localization:battle:render": "vitest run tests/ct2-overlay-runtime.test.ts --reporter=dot",
    "test:localization:menus": "node --test tools/ct2-menu-extract.test.mjs tools/ct2-menu-special.test.mjs",
    "test:localization:menus:rom": "node --test tools/ct2-menu-runtime.test.mjs",
    "test:localization:rom": "node --test tools/ct2-localization-runtime.test.mjs",
    "profile:captain-tsubasa-2": "node tools/compile-captain-tsubasa-2.mjs",
    "profile:captain-tsubasa-2:build-opening": "node tools/compile-captain-tsubasa-2-opening.mjs",
    "profile:captain-tsubasa-2:build-opening-alias": "node tools/compile-captain-tsubasa-2-opening.mjs \"roms/天使之翼2(足球小將2).zip\" public/game-profiles/captain-tsubasa-2-jp/captain-tsubasa-2-opening-zh-Hant-header-variant.gmod",
    "profile:captain-tsubasa-2:compile-opening": "node tools/captain-tsubasa-2-adapter.mjs compile-script --input game-profiles/captain-tsubasa-2-jp/translations/opening.intro.00.zh-Hant.json --output artifacts/captain-tsubasa-2-opening-zh-Hant-compiled.json",
    "profile:captain-tsubasa-2:compile-dictionary": "node tools/captain-tsubasa-2-adapter.mjs compile-dictionary --input game-profiles/captain-tsubasa-2-jp/translations/fixed-bank-words.zh-Hant.json --output artifacts/captain-tsubasa-2-fixed-bank-words-compiled.json",
    "profile:captain-tsubasa-2:export-opening": "node tools/captain-tsubasa-2-adapter.mjs export-script --output game-profiles/captain-tsubasa-2-jp/translations/opening.intro.00.zh-Hant.json",
    "profile:captain-tsubasa-2:roundtrip": "node tools/captain-tsubasa-2-adapter.mjs verify-roundtrip",
    "extract:zombie-hunter": "node tools/build-zombie-hunter-evidence.mjs",
    "extract:zombie-hunter:static": "node tools/extract-zombie-hunter-static.mjs",
    "localization:zombie:build": "node tools/zombie-hunter-menu-probe.mjs && node tools/zombie-submenu-probe.mjs && node tools/zombie-name-probe.mjs && node tools/build-zombie-hunter-menus.mjs",
    "test:localization:zombie": "node --test tools/decode-zombie-hunter-stream.test.mjs tools/extract-zombie-hunter-static.test.mjs tools/build-zombie-hunter-evidence.test.mjs tools/zombie-hunter-menus-runtime.test.mjs tools/zombie-names-runtime.test.mjs && vitest run tests/zombie-menu-overlay.test.ts",
    "test:zombie:stats": "node --test tools/zombie-runtime-tuning.test.mjs && vitest run tests/zombie-runtime-tuning.test.ts",
    "test:zombie:stats:rom": "cargo test --manifest-path nes-wasm/Cargo.toml --release zombie_original_stats_research -- --ignored --nocapture",
    "audit:games": "node tools/audit-game-catalog.mjs",
    "normalize:descriptions": "node tools/normalize-editorial-descriptions.mjs",
    "apply:user-descriptions": "node tools/apply-user-editorial-descriptions.mjs",
    "normalize:cover-search": "node tools/update-missing-cover-searches.mjs",
    "import:libretro-covers": "node tools/import-libretro-covers.mjs",
    "import:user-covers": "node tools/import-user-covers.mjs",
    "collect:covers": "node tools/collect-game-covers.mjs",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "jsdom": "^29.1.1",
    "opencc-js": "^1.4.1",
    "sharp": "^0.35.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "nes",
    "emulator",
    "6502",
    "typescript",
    "html5"
  ],
  "dependencies": {
    "@emulatorjs/core-genesis_plus_gx": "^4.2.3",
    "@emulatorjs/core-snes9x": "^4.2.3",
    "@emulatorjs/emulatorjs": "^4.2.3",
    "@mantou/fbneo": "^0.0.4",
    "fast-xml-parser": "^5.11.1",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "mupen64plus-web": "^1.5.7",
    "rom-patcher": "^3.1.0-b"
  }
}
